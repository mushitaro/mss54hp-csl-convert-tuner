# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only reference material (not for distribution)
/reference/

# Cloudflare local secrets. The real token lives in `wrangler pages secret`, never here.
.dev.vars
.wrangler/

# The run-store upload token. Generated locally, never committed; the authoritative
# copy lives in \`wrangler pages secret\`. Read it from here to type into the phone.
.upload-token.local
