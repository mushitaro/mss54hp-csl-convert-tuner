{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `functions/` is the Cloudflare Pages API and runs in the Workers runtime, not the browser.
  // It has its own tsconfig with the Workers types, which cannot be merged into this one: both
  // define a global `Response`/`Request`/`fetch` with different shapes, and whichever wins makes
  // the other half of the repo wrong. Two roots, one for each runtime.
  "exclude": ["node_modules", "functions"]
}
